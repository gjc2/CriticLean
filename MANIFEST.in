include README.en.md LICENSE NOTICE Makefile Dockerfile .env.example .dockerignore
include AGENTS.md RELEASE_FILES.txt
recursive-include LICENSES *.txt
include .gitignore .python-version
recursive-include configs *.json
recursive-include docs *.md
recursive-include examples *
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github *.yml
global-exclude __pycache__ *.py[cod]
prune data
prune runs
prune .venv
